{
    "repository": "s3:https://s3.<region>.backblazeb2.com/<bucket>/restic",
    "credentials_file": "<profile>.credentials.json",
    "restic_args": ["--retry-lock", "2m"],
    "backup_paths": ["~/path/to/files"],
    "backup_args": ["--exclude-caches", "--skip-if-unchanged"],
    "tags": [],
    "forget_args": [
        "--keep-daily", "7",
        "--keep-weekly", "5",
        "--keep-monthly", "12",
        "--keep-yearly", "3"
    ],
    "forget": {
        "schedule": "weekly",
        "backend": "auto",
        "catch_up": true,
        "prune": false
    },
    "check_args": [],
    "schedule": {
        "backend": "auto",
        "cron": "0 2 * * *",
        "catch_up": true
    },
    "sqlite_databases": [
        {
            "name": "primary",
            "path": "~/path/to/application.sqlite3"
        },
        {
            "name": "secondary",
            "path": "~/path/to/another.sqlite3"
        }
    ]
}
