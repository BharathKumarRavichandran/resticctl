{
    "repository": "s3:https://s3.<region>.backblazeb2.com/<bucket>/restic",
    "credentials_file": "<profile>.credentials.json",
    "restic_args": ["--retry-lock", "2m"],
    "backup_paths": ["~/path/to/files"],
    "backup_args": ["--exclude-caches", "--skip-if-unchanged"],
    "tags": [],
    "forget_args": [
        "--keep-daily", "7",
        "--keep-weekly", "5",
        "--keep-monthly", "12",
        "--keep-yearly", "3"
    ],
    "forget": {
        "cron": "weekly",
        "backend": "auto",
        "catch_up": true,
        "prune": false
    },
    "check_args": [],
    "check_before": false,
    "check_after": false,
    "prune_before": false,
    "prune_after": false,
    "run_before": [],
    "run_after": [],
    "run_after_fail": [],
    "run_finally": [],
    "database_concurrency": 1,
    "schedule": {
        "backend": "auto",
        "cron": "0 2 * * *",
        "catch_up": true
    },
    "sqlite_databases": [
        {
            "name": "primary",
            "path": "~/path/to/application.sqlite3"
        },
        {
            "name": "secondary",
            "path": "~/path/to/another.sqlite3"
        }
    ],
    "postgresql_databases": [
        {
            "name": "application",
            "database": "application",
            "host": "localhost",
            "port": 5432,
            "username": "backup",
            "executable": "pg_dump",
            "globals": false,
            "globals_executable": "pg_dumpall",
            "args": ["--no-owner"]
        }
    ],
    "mongodb_databases": [
        {
            "name": "events",
            "database": "events",
            "host": "localhost",
            "port": 27017,
            "executable": "mongodump",
            "config_file": "mongo-backup.yml",
            "args": []
        }
    ],
    "mysql_databases": [
        {
            "name": "orders",
            "database": "shop",
            "host": "localhost",
            "port": 3306,
            "username": "backup",
            "executable": "mysqldump",
            "args": [],
            "tables": [],
            "routines": false,
            "events": false,
            "triggers": true
        }
    ]
}
